DATABASE_URL="postgresql://lifelinex:lifelinex@localhost:5433/lifelinex?schema=public"

# Cashfree Payment Gateway — App ID and Secret Key from the merchant dashboard.
# Use sandbox keys with CASHFREE_ENV=sandbox while testing.
CASHFREE_ENV="sandbox"
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""

# Public site URL, and the canonical origin for canonical tags, the sitemap and
# og:image URLs. Use the apex host with no trailing slash — www.lifelinex.in 301s to it.
# Required in production and must be https; webhooks are only sent to https URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs customer booking-access cookies. Required in production: 32+ random characters,
# e.g. `openssl rand -hex 32`. Changing it signs every customer out of their booking page.
APP_SECRET=""

CONSULTATION_FEE_INR="999"

# Optional: Slack-compatible incoming webhook (https) told about paid orders and bookings.
ORDER_NOTIFY_WEBHOOK_URL=""

# SMTP — sends Google Meet links after booking (Hostinger email or any SMTP provider).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="consultations@lifelinex.in"

# Google Calendar service account — auto-creates Google Meet links on booking.
# Share your calendar with the service account email (Make changes to events).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Analytics and ad measurement. Both optional and both load only after the visitor
# accepts the cookie notice. Leaving these empty disables the cookie notice too, and
# keeps the stricter content-security policy (see next.config.ts).
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Staging escape hatch: set to 1 to build with lib/business.ts placeholders still in
# place. Never set this on the production build.
ALLOW_PLACEHOLDER_BUSINESS_INFO=""
